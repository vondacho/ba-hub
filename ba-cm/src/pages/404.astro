---
import Layout from '../layouts/Layout.astro';

// Asks the server for nothing, so it says so structurally rather than in a
// comment.
export const prerender = true;
---

<Layout title="Not found — Context mapper">
	<main id="main" class="mx-auto w-full max-w-2xl px-6 py-24">
		<h1 class="text-3xl font-bold">That page does not exist</h1>
		<p class="mt-4 text-ink-muted dark:text-slate-400">
			There are two: <a class="font-semibold text-brand underline" href="/">the mapper</a> and
			<a class="font-semibold text-brand underline" href="/dsl">the format</a>.
		</p>
	</main>
</Layout>
