---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import SectionPanels, { type Panel } from '../components/home/SectionPanels.astro';
import Testimonials from '../components/home/Testimonials.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import { counts } from '../lib/catalog';
import { landscapeCounts } from '../lib/landscapes';

/*
 * The six areas of the hub, in the order the work runs: learn the distinctions,
 * write down what you found, check it against what the systems do, and only
 * then reach for a tool.
 *
 * Documentation, Catalog, Landscapes and Tools are `live` — the pages behind
 * them exist and are worth opening, and Tools now fronts a deployed board as
 * well as four designs. MCP is `soon`: the four servers are described, not
 * built. Academy is `soon` because the curriculum is settled and the lessons
 * are not written.
 *
 * The home page should not promise anything that is not behind the link.
 */
const areas: readonly Panel[] = [
	{
		title: 'Documentation',
		description:
			'Domain-driven analysis end to end: domains and subdomains, the bounded contexts that solve them, the ubiquitous language that gives a boundary its edge, the model inside it, and the processes that run across it.',
		href: '/doc/',
		cta: 'Read the approach',
		status: 'live',
		icon: 'M5 4h9l5 5v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm8 0v6h6M8 14h8M8 17.5h5',
	},
	{
		title: 'Catalog',
		description: `The register of what the business is: one domain, ${counts.subdomains} subdomains split ${counts.core} core / ${counts.supporting} supporting / ${counts.generic} generic, and ${counts.contexts} bounded contexts — each with its language, its aggregates and a named owner.`,
		href: '/catalog',
		cta: 'Browse the catalog',
		status: 'live',
		icon: 'M4 6.5A1.5 1.5 0 0 1 5.5 5H10v14H5.5A1.5 1.5 0 0 1 4 17.5v-11Zm6-1.5h8.5A1.5 1.5 0 0 1 20 6.5v11a1.5 1.5 0 0 1-1.5 1.5H10M13 9h4M13 12.5h4',
	},
	{
		title: 'Landscapes',
		description: `Two maps and the gap between them. The context map says how the boundaries are meant to relate; the system map says what ${counts.systems} running systems actually do. ${landscapeCounts.findings} of ${landscapeCounts.integrations} observed integrations disagree with the model.`,
		href: '/landscapes',
		cta: 'Compare the two maps',
		status: 'live',
		icon: 'M9 4 3 6.5v13L9 17l6 2.5 6-2.5v-13L15 6.5 9 4Zm0 0v13m6-10.5V19.5',
	},
	{
		title: 'Tools',
		description:
			'The Event Stormer, which is real: event storming and process modelling on one board, at big picture, process or software-design depth. And the DDD mapper, which is not yet: catalog in, landscape evidence ingested, and a conformance verdict against every edge.',
		href: '/tools',
		cta: 'See the tools',
		// `live` since the Event Stormer shipped — one of the five is deployed and
		// usable, and the page says plainly which. The rest carry their own badges.
		status: 'live',
		icon: 'M14.5 3.5a4.5 4.5 0 0 0-5.9 5.7L3.5 14.3a1.5 1.5 0 0 0 0 2.1l2.1 2.1a1.5 1.5 0 0 0 2.1 0l5.1-5.1a4.5 4.5 0 0 0 5.7-5.9l-2.9 2.9-2.6-.7-.7-2.6 2.9-2.9Z',
	},
	{
		title: 'MCP',
		description:
			'The half of the work a model can do: distilling subdomains from what the business already wrote down, extracting language and its collisions, proposing context relationships, and reading drift out of the landscape evidence.',
		href: '/doc/mcp/',
		cta: 'See what is automated',
		status: 'soon',
		icon: 'M12 3v4m0 10v4M3 12h4m10 0h4M7.5 7.5l2.8 2.8m3.4 3.4 2.8 2.8m0-9-2.8 2.8m-3.4 3.4-2.8 2.8',
	},
	{
		title: 'Academy',
		description:
			'Seven learning paths, from hearing a domain in the language people already use, through drawing boundaries and modelling inside them, to reading drift as a business cost rather than a technical complaint.',
		href: '/academy',
		cta: 'See the curriculum',
		status: 'soon',
		icon: 'M12 4 22 9l-10 5L2 9l10-5Z M6 11.5v4.7c0 .8.5 1.4 1.2 1.8 1.3.7 2.9 1.1 4.8 1.1s3.5-.4 4.8-1.1c.7-.4 1.2-1 1.2-1.8v-4.7 M22 9v5.5',
	},
] as const;
---

<Layout
	title="BA Hub — domain-driven business analysis"
	description="Domains, subdomains and bounded contexts with their domain models and business processes, catalogued — and monitored against what the running systems actually implement."
>
	<main id="main">
		<Hero
			kicker="Domain-driven business analysis"
			title="The business already has a model. Most of it is just not written down anywhere."
			lead="It lives in the words people use, in the exceptions they apologise for, and in the
				arguments that never quite resolve because two departments mean different things by
				the same noun. Domain-driven analysis is the work of finding those boundaries,
				naming them, and writing down the model that holds inside each one. And then the
				part that usually gets skipped: checking, continuously, whether the systems anyone
				actually runs still respect them."
			actions={[
				{ label: 'Read the approach', href: '/doc/approach/' },
				{ label: 'Browse the catalog', href: '/catalog' },
			]}
		/>

		<!--
			The teasing section. Deliberately three numbers rather than three
			adjectives: the argument this hub makes is that a model you cannot count
			against reality is a drawing, so the home page leads with the count.

			They are computed from the data, not typed here — a figure that has to be
			updated by hand is a figure that will be wrong.
		-->
		<section
			aria-labelledby="teaser"
			class="border-y border-slate-200 bg-slate-50 py-16 sm:py-20 dark:border-slate-800 dark:bg-night-raised"
		>
			<div class="mx-auto w-full max-w-5xl px-6">
				<p class="text-xs font-semibold tracking-[0.16em] text-brand uppercase dark:text-purple-400">
					Why this hub exists
				</p>
				<h2 id="teaser" class="mt-3 max-w-3xl text-2xl font-bold tracking-tight text-balance sm:text-3xl">
					A catalogue of intent is a diagram. A catalogue checked against the estate is a model.
				</h2>
				<p class="mt-4 max-w-3xl text-ink-muted dark:text-slate-400">
					Most domain modelling stops at the point it becomes valuable. The boundaries get
					drawn, the workshop ends, the diagram goes into a wiki, and four years later
					nobody can say which of it is still true. This hub is built around the assumption
					that the second half is the half worth paying for — so every bounded context here
					carries the systems that claim to implement it, and every relationship on the
					context map is checked against an integration somebody observed.
				</p>

				<dl class="mt-10 grid gap-6 sm:grid-cols-3">
					<div class="rounded-2xl border border-slate-200 bg-white p-7 dark:border-slate-700 dark:bg-night">
						<dt class="text-sm font-semibold tracking-wide text-ink-muted uppercase dark:text-slate-400">
							Bounded contexts
						</dt>
						<dd class="mt-2 text-4xl font-bold tracking-tight text-brand dark:text-purple-400">
							{counts.contexts}
						</dd>
						<dd class="mt-2 text-sm text-ink-muted dark:text-slate-400">
							Across {counts.subdomains} subdomains, of which {counts.core} are core. {counts.modelled} are
							modelled to the level of aggregates and invariants; the rest are honest about
							being a boundary and a name.
						</dd>
					</div>
					<div class="rounded-2xl border border-slate-200 bg-white p-7 dark:border-slate-700 dark:bg-night">
						<dt class="text-sm font-semibold tracking-wide text-ink-muted uppercase dark:text-slate-400">
							Observed integrations
						</dt>
						<dd class="mt-2 text-4xl font-bold tracking-tight text-brand dark:text-purple-400">
							{landscapeCounts.integrations}
						</dd>
						<dd class="mt-2 text-sm text-ink-muted dark:text-slate-400">
							Between {counts.systems} running systems, each recorded with the evidence that
							observed it rather than with the memory of the person who drew it.
						</dd>
					</div>
					<div class="rounded-2xl border border-slate-200 bg-white p-7 dark:border-slate-700 dark:bg-night">
						<dt class="text-sm font-semibold tracking-wide text-ink-muted uppercase dark:text-slate-400">
							Findings open
						</dt>
						<dd class="mt-2 text-4xl font-bold tracking-tight text-brand dark:text-purple-400">
							{landscapeCounts.findings}
						</dd>
						<dd class="mt-2 text-sm text-ink-muted dark:text-slate-400">
							Integrations that drift from the model, run without one, or exist on the map with
							nothing behind them. Each one names what it costs and who can fix it.
						</dd>
					</div>
				</dl>
			</div>
		</section>

		<SectionPanels panels={areas} label="Areas" columns={3} />
		<Testimonials />
	</main>
	<SiteFooter />
</Layout>
