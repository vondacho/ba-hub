---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/home/Hero.astro';
import SectionPanels, { type Panel } from '../../components/home/SectionPanels.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';
import {
	contextName,
	integrations,
	landscapeCounts,
	relationships,
	unrealisedRelationships,
	type SystemIntegration,
} from '../../lib/landscapes';
import { counts, systems } from '../../lib/catalog';

/*
 * The two landscapes, and the third table that is the reason for having two.
 *
 * Context mapping is intent, system mapping is reality, and the value of this
 * page is entirely in where they disagree. So the findings table is not an
 * appendix at the bottom — the panels front the two maps, then the disagreements
 * come before the maps themselves, because a reader who only ever reads one
 * section of this page should read that one.
 *
 * Data lives in src/lib/landscapes.ts. Nothing here is hardcoded, including the
 * counts, so a new integration edge cannot leave the prose stale.
 */

const panels: readonly Panel[] = [
	{
		title: 'Context mapping',
		description: `How the ${counts.contexts} bounded contexts are meant to relate, in the vocabulary of the strategic patterns: who is upstream, who conforms because they had no choice, where an anticorruption layer is doing real work. ${landscapeCounts.relationships} relationships declared.`,
		href: '/doc/landscapes/context-mapping/',
		cta: 'How the map is drawn',
		status: 'live',
		icon: 'M9 4 3 6.5v13L9 17l6 2.5 6-2.5v-13L15 6.5 9 4Zm0 0v13m6-10.5V19.5',
	},
	{
		title: 'System mapping',
		description: `What the ${counts.systems} running systems actually do to each other, observed rather than asserted: ${landscapeCounts.integrations} integrations, each recorded with the evidence that found it and the mechanism it runs over.`,
		href: '/doc/landscapes/system-mapping/',
		cta: 'How the evidence is gathered',
		status: 'live',
		icon: 'M6.5 4h11a1.5 1.5 0 0 1 1.5 1.5v3A1.5 1.5 0 0 1 17.5 10h-11A1.5 1.5 0 0 1 5 8.5v-3A1.5 1.5 0 0 1 6.5 4Zm0 10h11a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 18.5v-3A1.5 1.5 0 0 1 6.5 14ZM8 7h.01M8 17h.01',
	},
	{
		title: 'Conformance and drift',
		description: `The difference between the two, as findings with owners. ${landscapeCounts.findings} of ${landscapeCounts.integrations} integrations disagree with the model, and ${landscapeCounts.unrealised} declared relationships have nothing observed behind them.`,
		href: '/doc/landscapes/conformance/',
		cta: 'How drift is judged',
		status: 'live',
		icon: 'M12 3.5 20.5 18a1 1 0 0 1-.9 1.5H4.4a1 1 0 0 1-.9-1.5L12 3.5Zm0 5v5m0 3h.01',
	},
] as const;

const verdictLabel: Record<SystemIntegration['verdict'], string> = {
	matches: 'Matches',
	drifts: 'Drifts',
	unmapped: 'Unmapped',
	missing: 'Unobserved',
};

// Written out rather than interpolated — Tailwind cannot see a class name
// assembled at runtime.
const verdictChip: Record<SystemIntegration['verdict'], string> = {
	matches: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950/60 dark:text-emerald-300',
	drifts: 'bg-rose-100 text-rose-900 dark:bg-rose-950/60 dark:text-rose-300',
	unmapped: 'bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300',
	missing: 'bg-slate-200 text-ink-muted dark:bg-slate-700 dark:text-slate-300',
};

const findings = integrations.filter((integration) => integration.verdict !== 'matches');
---

<Layout
	title="Landscapes — BA Hub"
	description="Two maps of the same estate: a context map of how the bounded contexts are meant to relate, a system map of what the running systems actually do, and the conformance findings where the two disagree."
>
	<main id="main">
		<Hero
			kicker="Landscapes"
			title="One map says what we agreed. The other says what is running. Neither is interesting alone."
			lead="A context map with no system map behind it is a wish that survives because nothing
				contradicts it. A system map with no context map above it is a network diagram — true,
				and unable to tell you which of its arrows should not exist. Draw both against the same
				catalog and the third artefact appears for free: a list of the places where the estate
				has quietly stopped implementing the business."
			parent={{ label: 'Home', href: '/' }}
			actions={[
				{ label: 'Read the catalog first', href: '/catalog' },
				{ label: 'How drift is judged', href: '/doc/landscapes/conformance/' },
			]}
		/>

		<SectionPanels panels={panels} label="Landscapes" columns={3} />

		<section
			aria-labelledby="findings"
			class="border-y border-slate-200 bg-slate-50 py-16 sm:py-20 dark:border-slate-800 dark:bg-night-raised"
		>
			<div class="mx-auto w-full max-w-5xl px-6">
				<p class="text-xs font-semibold tracking-[0.16em] text-brand uppercase dark:text-purple-400">
					Where they disagree
				</p>
				<h2 id="findings" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
					{landscapeCounts.findings} findings
				</h2>
				<p class="mt-3 max-w-3xl text-ink-muted dark:text-slate-400">
					Each one is a sentence about the business, not about the wiring. &ldquo;Claims reads
					the live policy&rdquo; is an integration detail; &ldquo;a claim can be assessed
					against cover that was added after the loss&rdquo; is the same fact stated so that
					somebody who can authorise the fix understands it.
				</p>

				<ul class="mt-10 space-y-5">
					{
						findings.map((finding) => (
							<li class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-night">
								<div class="flex flex-wrap items-center justify-between gap-3">
									<p class="font-mono text-sm">
										<span class="font-semibold">{finding.from}</span>
										<span aria-hidden="true" class="mx-2 text-ink-muted dark:text-slate-500">
											&rarr;
										</span>
										<span class="font-semibold">{finding.to}</span>
									</p>
									<span
										class={`rounded-full px-3 py-1 text-xs font-semibold uppercase ${verdictChip[finding.verdict]}`}
									>
										{verdictLabel[finding.verdict]}
									</span>
								</div>

								<p class="mt-4 text-sm text-ink-muted dark:text-slate-400">
									<span class="font-semibold text-ink dark:text-slate-200">Observed: </span>
									{finding.evidence}
								</p>

								{finding.realises ? (
									<p class="mt-2 text-sm text-ink-muted dark:text-slate-400">
										<span class="font-semibold text-ink dark:text-slate-200">Should realise: </span>
										{contextName(finding.realises.upstream)}
										<span aria-hidden="true"> &rarr; </span>
										{contextName(finding.realises.downstream)}
									</p>
								) : (
									<p class="mt-2 text-sm text-ink-muted dark:text-slate-400">
										<span class="font-semibold text-ink dark:text-slate-200">Should realise: </span>
										<em>nothing on the context map corresponds to this integration.</em>
									</p>
								)}

								{finding.finding && (
									<p class="mt-4 border-t border-slate-200 pt-4 text-sm dark:border-slate-700">
										{finding.finding}
									</p>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section aria-labelledby="context-map" class="mx-auto w-full max-w-5xl px-6 py-16 sm:py-20">
			<h2 id="context-map" class="text-2xl font-semibold tracking-tight">The context map</h2>
			<p class="mt-2 max-w-3xl text-ink-muted dark:text-slate-400">
				Intent. The pattern column is the one that carries the information: customer/supplier
				and conformist describe the same arrow and differ only in whether the downstream team
				has any negotiating power, which is a political fact a generic &ldquo;depends on&rdquo;
				would hide. {landscapeCounts.mappedContexts} of{' '}
				{landscapeCounts.catalogContexts} catalogued contexts appear here.
			</p>

			<div class="mt-8 overflow-x-auto">
				<table class="w-full min-w-[52rem] border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-slate-300 dark:border-slate-700">
							<th scope="col" class="py-3 pr-4 font-semibold">Upstream</th>
							<th scope="col" class="py-3 pr-4 font-semibold">Downstream</th>
							<th scope="col" class="py-3 pr-4 font-semibold">Pattern</th>
							<th scope="col" class="py-3 pr-4 font-semibold">What crosses</th>
							<th scope="col" class="py-3 font-semibold">Why this pattern</th>
						</tr>
					</thead>
					<tbody>
						{
							relationships.map((relationship) => (
								<tr class="border-b border-slate-200 align-top dark:border-slate-800">
									<th scope="row" class="py-3 pr-4 font-semibold">
										{contextName(relationship.upstream)}
									</th>
									<td class="py-3 pr-4 font-semibold">{contextName(relationship.downstream)}</td>
									<td class="py-3 pr-4 whitespace-nowrap text-brand dark:text-purple-400">
										{relationship.pattern}
									</td>
									<td class="py-3 pr-4 text-ink-muted dark:text-slate-400">
										{relationship.exchange}
									</td>
									<td class="py-3 text-ink-muted dark:text-slate-400">{relationship.rationale}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			{
				unrealisedRelationships.length > 0 && (
					<p class="mt-6 rounded-xl border border-amber-300 bg-amber-50 p-5 text-sm dark:border-amber-700/60 dark:bg-amber-950/40">
						<strong>
							{unrealisedRelationships.length} declared{' '}
							{unrealisedRelationships.length === 1 ? 'relationship has' : 'relationships have'}{' '}
							nothing observed behind{' '}
							{unrealisedRelationships.length === 1 ? 'it' : 'them'}.
						</strong>
						<span class="mt-1 block text-ink-muted dark:text-slate-400">
							{unrealisedRelationships
								.map((r) => `${contextName(r.upstream)} → ${contextName(r.downstream)}`)
								.join(', ')}
							. Either the integration exists and the collector cannot see it, or the
							relationship was agreed and never built. The two have very different owners, and
							the map cannot tell them apart on its own.
						</span>
					</p>
				)
			}
		</section>

		<section
			aria-labelledby="system-map"
			class="border-t border-slate-200 py-16 sm:py-20 dark:border-slate-800"
		>
			<div class="mx-auto w-full max-w-5xl px-6">
				<h2 id="system-map" class="text-2xl font-semibold tracking-tight">The system map</h2>
				<p class="mt-2 max-w-3xl text-ink-muted dark:text-slate-400">
					Reality, across {counts.systems} systems: {systems.join(', ')}. Every row carries the
					observation that produced it, so a reader who doubts one can go and check it — which
					is the difference between a map and a diagram.
				</p>

				<div class="mt-8 overflow-x-auto">
					<table class="w-full min-w-[52rem] border-collapse text-left text-sm">
						<thead>
							<tr class="border-b border-slate-300 dark:border-slate-700">
								<th scope="col" class="py-3 pr-4 font-semibold">From</th>
								<th scope="col" class="py-3 pr-4 font-semibold">To</th>
								<th scope="col" class="py-3 pr-4 font-semibold">Transport</th>
								<th scope="col" class="py-3 pr-4 font-semibold">Evidence</th>
								<th scope="col" class="py-3 font-semibold">Verdict</th>
							</tr>
						</thead>
						<tbody>
							{
								integrations.map((integration) => (
									<tr class="border-b border-slate-200 align-top dark:border-slate-800">
										<th scope="row" class="py-3 pr-4 font-mono text-xs font-semibold whitespace-nowrap">
											{integration.from}
										</th>
										<td class="py-3 pr-4 font-mono text-xs whitespace-nowrap">{integration.to}</td>
										<td class="py-3 pr-4 text-ink-muted dark:text-slate-400">
											{integration.transport}
										</td>
										<td class="py-3 pr-4 text-ink-muted dark:text-slate-400">
											{integration.evidence}
										</td>
										<td class="py-3">
											<span
												class={`rounded-full px-2.5 py-0.5 text-xs font-semibold whitespace-nowrap uppercase ${verdictChip[integration.verdict]}`}
											>
												{verdictLabel[integration.verdict]}
											</span>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>

				<p class="mt-8 max-w-3xl text-sm text-ink-muted dark:text-slate-400">
					Collection is not deployed yet, so the evidence column is a worked example of what
					the collector would write rather than what it has written. The
					<a href="/tools" class="font-semibold text-brand underline-offset-4 hover:underline dark:text-purple-400">
						tools page
					</a>
					says what it would take.
				</p>
			</div>
		</section>
	</main>
	<SiteFooter />
</Layout>
