# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# Contact address Let's Encrypt uses for expiry warnings.
acme_email = "you@example.com"

# Set false if the account already has a provider for
# token.actions.githubusercontent.com — AWS allows only one per issuer URL.
# Check with: aws iam list-open-id-connect-providers
create_github_oidc_provider = true

# Optional — these are the defaults.
# Named profile from ~/.aws/config; omit to use the ambient credential chain.
# aws_profile       = "ba-hub"
# aws_region        = "eu-central-1"
# domain            = "obya.ch"
# portal_subdomain  = "ba-portal"
# mapper_subdomain  = "ddd-mapper"
# instance_type     = "t3.small"
# github_repository = "vondacho/ba-hub"
# github_deploy_ref = "refs/heads/main"

# Break-glass only. Both default to nothing: administration goes through SSM
# Session Manager, so the host normally has no key pair and no open port 22.
# ssh_key_name      = "ba-hub"
# ssh_allowed_cidrs = ["203.0.113.4/32"]
